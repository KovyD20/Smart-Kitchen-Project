# Firebase web app config (Firebase Console -> Project Settings -> Your apps).
# These are public by design — they identify the project, they do not grant access.
# Access is controlled by Firebase Auth + Firestore security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public URL of the Express backend. Leave EMPTY for local development: paths stay
# relative and Vite's dev proxy forwards /api to http://localhost:3000.
# Set it only for deployed builds, where the frontend and backend live on
# different origins, e.g. https://smart-kitchen-api.onrender.com
VITE_API_BASE_URL=
