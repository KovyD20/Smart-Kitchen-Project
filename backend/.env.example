# Backend environment variables.
# Copy this to backend/.env and fill in real values (backend/.env is git-ignored).

# PostgreSQL connection.
# Local Postgres: host=localhost. Managed host (Neon / Supabase): use the values
# from the provider's connection details.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_kitchen
DB_USER=smart_user
DB_PASSWORD=smart_pass

# Google Gemini (AI recipe endpoints).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin (verifies ID tokens on protected /api/ai/* endpoints).
# From the service-account JSON: Firebase Console > Project settings >
# Service accounts > Generate new private key. Paste the private key on a single
# line with literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Allowed CORS origin(s) for the frontend (comma-separated). Dev default below.
CORS_ORIGIN=http://localhost:5173
