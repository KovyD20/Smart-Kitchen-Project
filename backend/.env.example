# Backend environment variables.
# Copy this to backend/.env and fill in real values (backend/.env is git-ignored).
# When deploying, paste the same keys into your host's environment settings.

PORT=3000

# Allowed CORS origin(s) for the frontend (comma-separated). Dev default below;
# in production add your deployed frontend URL, e.g. https://smart-kitchen.vercel.app
CORS_ORIGIN=http://localhost:5173

# Set to "true" only behind a reverse proxy that sets X-Forwarded-For (Render,
# Railway, Fly, Nginx) so req.ip is the real client. Leave false locally, where
# trusting the header would let a caller spoof its own IP.
TRUST_PROXY=false

# Reported by /health — useful for telling replicas apart.
INSTANCE_NAME=local

# PostgreSQL connection (pantry catalog).
# Local Postgres: host=localhost. Managed host (Neon / Supabase): use the values
# from the provider's connection details.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_kitchen
DB_USER=smart_user
DB_PASSWORD=smart_pass
# Set to "true" for managed hosts that require TLS (Neon, Supabase). Leave empty/false for local.
DB_SSL=false

# Google Gemini (AI recipe endpoints).
# Lives ONLY here — never in the frontend bundle, which is public.
GEMINI_API_KEY=

# Model id. Flash generations are retired hard (the old id starts answering 404),
# so this is an env var on purpose: swapping models is a config change, not a code
# change. Check the model list about twice a year; `npm run ai:smoke` reports which
# model is in use and why a call failed.
AI_MODEL=gemini-3.6-flash

# Client-side timeout for a single AI call, in ms. Optional; defaults to 90000.
# Must stay comfortably under undici's 300s headersTimeout.
#AI_TIMEOUT_MS=90000

# Firebase Admin (verifies ID tokens on protected /api/ai/* endpoints).
# From the service-account JSON: Firebase Console > Project settings >
# Service accounts > Generate new private key. Paste the private key on a single
# line with literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
